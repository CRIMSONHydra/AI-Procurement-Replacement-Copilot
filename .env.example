# Local mock service
VENDOR_RISK_BASE_URL=http://127.0.0.1:8001

# Gemini (Google AI Studio) key - https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Primary model (default: gemini-3.1-flash-lite - free tier 15 RPM / 500 requests per day; the evaluated model)
MODEL_NAME=gemini-3.1-flash-lite
# Tried in order when the primary stays rate-limited/overloaded (one model per run). Empty = no fallback.
MODEL_FALLBACKS=gemini-3.8-flash,gemma-4-31b-it
# Optional client-side pacing (requests/minute) to stay under free-tier quotas.
# LLM_RPM=5
